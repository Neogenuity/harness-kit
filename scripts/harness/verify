#!/usr/bin/env bash
# verify — the executable definition of "done": runs the quality gates
# declared in .harness/gates.conf. AGENTS.md, CLAUDE.md, and the skills all
# point HERE instead of listing commands, so the gates can never disagree
# across files.
#
#   bash scripts/harness/verify          # every gate
#   bash scripts/harness/verify --fast   # fast gates only — cheap enough for
#                                        # an agent stop-hook
#   bash scripts/harness/verify --changed # skip gates PROVEN unchanged (below)
#   bash scripts/harness/verify --jobs 4 # cap concurrent parallel gates
#   HARNESS_JOBS=4 bash scripts/harness/verify   # same cap, via environment
#
# MECHANISM/POLICY SPLIT (v0.23.0): this runner is kit-owned mechanism,
# replaced on update like any other file; the REPO owns its gate list as
# data in .harness/gates.conf (policy, pinned diff-only). One declaration
# per line ('#' lines and blanks ignored), commands run via `bash -c` from
# the repo root:
#
#   gate          <label> <command...>     # both modes; keep fast (ms-s)
#   full          <label> <command...>     # serial; skipped under --fast
#   parallel      <label> <command...>     # independent; queued to the barrier
#   parallel-each <label-prefix> <glob...> # one parallel gate per matching
#                                          # file; each runs `bash <file>`
#
# Keep serial gates cheapest-first so failures surface early; a failing
# serial gate stops immediately. A `full` gate is also a dependency barrier
# for parallel gates declared before it. Parallel gates are reaped at the
# final barrier with buffered output and the exact re-run command.
#
# CHANGE-AWARE MODE (--changed): a gate is skipped ONLY on a digest proving
# its declared inputs are byte-identical to those of its last PASSING run.
# Never a relevance guess from a diff: a stale path->gate map is a silent
# skip, and a silent skip is a fake green verify. Declare inputs as a COMMENT
# directive in .harness/gates.conf, label-keyed:
#
#   # inputs <gate-label> <token>...
#
# A comment keeps the format compatible both ways — an older runner skips '#'
# lines and therefore RUNS the gate (the fail-closed direction), where a new
# gate kind would have been a hard parse error. Tokens are repo-root-relative
# files, directories (recursed) or globs, plus:
#
#   @git-head     include `git rev-parse HEAD`. Required for a gate that reads
#                 COMMITTED state (an eval workspace clones HEAD) and would
#                 otherwise be keyed on a working tree it never reads.
#   @tool:<name>  include a binary's resolved path and first --version line.
#
# PRECONDITIONS, both on the annotator:
#   1. Only annotate a gate whose sole externally visible effect is its exit
#      status. A `full` gate is a barrier precisely so a serial gate can consume
#      a parallel producer's output; caching a producer breaks its consumer, and
#      no token list can prove side-effect freedom.
#   2. The token set must COVER every input. A superset only costs cache misses;
#      a set missing a real input is a gate reported ok: on bytes it never read.
#      The runner keys on the environment, the gate list, itself and the declared
#      paths — it cannot discover an input you did not name.
#
# --changed is a LOCAL iteration tool. The cache lives in the git-ignored
# .harness/var/, writable by the same agent whose work verify gates, so CI and
# releases must keep running the full mode; --changed refuses under CI=true.
set -uo pipefail

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$ROOT" || exit 1
GATES_CONF="$ROOT/.harness/gates.conf"
LOG_LIB_PATH="${HARNESS_LOG_LIB:-$ROOT/scripts/harness/lib/log-lib.sh}"
# shellcheck source=/dev/null
[ -f "$LOG_LIB_PATH" ] && . "$LOG_LIB_PATH" 2>/dev/null || true

usage() {
    echo "usage: bash scripts/harness/verify [--fast | --changed] [--jobs N]   (or HARNESS_JOBS=N)" >&2
    exit 64
}

MODE=full
JOBS="${HARNESS_JOBS:-}"
while [ $# -gt 0 ]; do
    case "$1" in
        # Not "last flag wins": --fast asks for LESS coverage, --changed asks
        # for the same coverage minus what is proven unchanged. Silently
        # resolving the pair is how a caller ends up believing it ran more than
        # it did.
        --fast) [ "$MODE" = changed ] && usage; MODE=fast ;;
        --changed) [ "$MODE" = fast ] && usage; MODE=changed ;;
        --jobs) shift; [ -n "${1:-}" ] || usage; JOBS="$1" ;;
        --jobs=*) JOBS="${1#--jobs=}" ;;
        *) usage ;;
    esac
    shift
done
# Bounded concurrency (a conservative default): a repo with hundreds of test
# files under a parallel-each glob must not fork hundreds of simultaneous
# jobs. Default = the machine's core count (getconf works on macOS and
# Linux; Git Bash may lack it — fall back to 8). --jobs/HARNESS_JOBS must be
# a positive integer.
if [ -n "$JOBS" ]; then
    # Digit-only, then a numeric floor. The second check is not redundant:
    # "00" is all digits but numerically zero (the throttle loop would try to
    # reap job index -1), and a digit string past intmax makes `[ -lt ]`
    # error mid-throttle. `[ -ge 1 ]` catches the first, and its own error on
    # an unrepresentable integer routes to usage via the 2>/dev/null || arm.
    case "$JOBS" in *[!0-9]*) usage ;; esac
    [ "$JOBS" -ge 1 ] 2>/dev/null || usage
else
    JOBS=$(getconf _NPROCESSORS_ONLN 2>/dev/null) || JOBS=""
    case "$JOBS" in ''|0|*[!0-9]*) JOBS=8 ;; esac
fi

if [ ! -f "$GATES_CONF" ]; then
    echo "FAIL: .harness/gates.conf is missing — it is the repo's gate declaration (the policy half of verify; this runner is the mechanism half). Restore it, or re-run the kit's init/update." >&2
    exit 1
fi
# The cache is repo-local, git-ignored, and writable by the same agent whose
# work verify gates. That is fine for local iteration and NOT fine where the
# green is the artifact, so the one place it must never run refuses outright.
if [ "$MODE" = changed ] && [ "${CI:-}" = "true" ]; then
    echo "FAIL: --changed is a local iteration mode and refuses to run under CI=true; CI must run the full gate set." >&2
    exit 64
fi

VERIFY_RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)-$$"
VERIFY_CONTEXT='{}'
if command -v harness_log_context >/dev/null 2>&1; then
    VERIFY_CONTEXT=$(harness_log_context "$VERIFY_RUN_ID" verify \
        "${HARNESS_SESSION_ID:-}" "${HARNESS_SESSION_ID:+env}" \
        "${HARNESS_PROVIDER:-}" "${HARNESS_PROVIDER:+env}" \
        "${HARNESS_PLAN_SLUG:-}" "${HARNESS_PLAN_SLUG:+env}")
fi

# `mode` describes a gate's execution STRENGTH, not the invocation flag: a gate
# that runs under --changed runs byte-identically to one under full mode — same
# command, same environment, same exit-status contract. Reporting "full" keeps
# lib/audit-log.sh's mode enum and its daily gate roll-up meaningful without a
# schema change. A gate SKIPPED by the cache emits no event at all, matching the
# existing rule that a full gate skipped under --fast is not fabricated as a run.
EVENT_MODE="$MODE"
[ "$EVENT_MODE" = changed ] && EVENT_MODE=full

emit_gate_event() {
    local label="$1" outcome="$2" exit_code="$3" duration_s="$4" data
    command -v harness_log_v2 >/dev/null 2>&1 || return 0
    data=$(jq -cn --arg name "$label" --arg mode "$EVENT_MODE" --arg outcome "$outcome" \
        --argjson exit_code "$exit_code" --argjson duration_s "$duration_s" \
        '{name:$name,mode:$mode,outcome:$outcome,exit_code:$exit_code,duration_s:$duration_s}' \
        2>/dev/null) || return 0
    harness_log_v2 "$ROOT" verify.sh gate "" "" "$VERIFY_CONTEXT" "$data"
}

CACHE_DIR="$ROOT/.harness/var/gate-cache"
CACHED_SKIPS=0
DECL_LABELS=(); DECL_CMDS=()
INPUT_LABELS=(); INPUT_TOKENS=()

# One sha256 ladder, mirroring lib/install-lib.sh:_harness_sha256. Empty when
# neither tool exists, which every caller reads as "cannot prove anything —
# run the gate".
HASH_CMD=""
if command -v shasum >/dev/null 2>&1; then HASH_CMD="shasum -a 256"
elif command -v sha256sum >/dev/null 2>&1; then HASH_CMD="sha256sum"; fi

_digest_file() {
    [ -n "$HASH_CMD" ] && [ -f "$1" ] || return 1
    # shellcheck disable=SC2086
    $HASH_CMD "$1" 2>/dev/null | awk '{print $1; exit}'
}

# _env_material — ambient environment that can change a gate's outcome. This
# release's other half establishes that an exported variable can silently hollow
# out a gate, so memoizing a verdict without recording the environment that
# produced it would reintroduce the same class. Hashed: the search path and
# scratch dir every suite uses, the locale that decides collation, and the whole
# HARNESS_*/EVAL_* namespace this harness reads. Anything else a gate depends on
# must be pinned in the gate COMMAND (`env VAR=... ` / `env -u VAR`), which is
# already key material.
_env_material() {
    printf 'env|PATH|%s\n' "${PATH:-}"
    printf 'env|TMPDIR|%s\n' "${TMPDIR:-}"
    printf 'env|LANG|%s\n' "${LANG:-}"
    printf 'env|LC_ALL|%s\n' "${LC_ALL:-}"
    env 2>/dev/null \
        | LC_ALL=C sed -n 's/^\(HARNESS_[A-Za-z0-9_]*=\)/env|\1/p; s/^\(EVAL_[A-Za-z0-9_]*=\)/env|\1/p' \
        | LC_ALL=C sort
}

# _gate_material <label> <cmd> <tokens> — the bytes a gate's identity is made
# of, on stdout. Exit 0 = usable, 1 = cannot compute (run the gate), 2 = config
# error (FAIL). Everything that cannot be PROVEN returns 1: an unprovable gate
# runs, it never skips.
_gate_material() {
    local label="$1" cmd="$2" toks="$3" tok name ver d nfiles hashed got nul nl
    [ -n "$HASH_CMD" ] || return 1
    printf 'v1\nlabel|%s\ncmd|%s\ntokens|%s\n' "$label" "$cmd" "$toks"
    _env_material || return 1
    # Assign THEN print: `printf ... "$(cmd)" || return 1` tests printf, which
    # always succeeds, so the guard would be dead and a failed digest would
    # contribute an empty field to a key that is still trusted.
    # The runner itself: it decides the environment a gate inherits and the
    # cache semantics, so hashing $0 subsumes a hand-maintained format version.
    d=$(_digest_file "$0") || return 1
    printf 'self|%s\n' "$d"
    # The whole gate list, not just this gate's line: kind changes, reordering
    # and new neighbours all alter what a recorded pass described.
    d=$(_digest_file "$GATES_CONF") || return 1
    printf 'conf|%s\n' "$d"
    if [ -n "${HARNESS_VERIFY_PRELUDE:-}" ]; then
        d=$(_digest_file "$HARNESS_VERIFY_PRELUDE") || return 1
        printf 'prelude|%s\n' "$d"
    fi
    # `for tok in $toks` already applies word splitting AND pathname expansion,
    # so each $tok is ONE resolved path. Re-splitting it (an inner `for p in
    # $tok`) would break a path containing a space into fragments — hashing a
    # same-named decoy while the declared file stays invisible to the key.
    for tok in $toks; do
        case "$tok" in
            @git-head)
                command -v git >/dev/null 2>&1 || return 1
                d=$(git rev-parse HEAD 2>/dev/null) || return 1
                [ -n "$d" ] || return 1
                printf 'githead|%s\n' "$d"
                ;;
            @tool:*)
                name=${tok#@tool:}
                command -v "$name" >/dev/null 2>&1 || return 1
                ver=$("$name" --version 2>&1) || ver=""
                # Trim to the first line by expansion; a `| head -1` here is the
                # early-exiting-reader SIGPIPE class this repo has been bitten by.
                ver=${ver%%$'\n'*}
                printf 'tool|%s|%s|%s\n' "$name" "$(command -v "$name")" "$ver"
                ;;
            @*)
                echo "verify: unknown '# inputs' directive '$tok' for gate '$label'" >&2
                return 2
                ;;
            *)
                # An unmatched glob stays literal, so a token resolving to
                # nothing is caught here. That IS a config error: an input set
                # resolving to nothing would make every run a cache hit.
                if [ ! -e "$tok" ]; then
                    echo "verify: '# inputs' token '$tok' for gate '$label' matched no files — an input set that resolves to nothing would make every run a cache hit; fix the token in .harness/gates.conf" >&2
                    return 2
                fi
                # shasum FOLLOWS symlinks, so a link silently widens the real
                # footprint past what the annotation declares, and a newline in a
                # filename truncates the inventory (a false HIT, not a miss).
                # Neither is a config ERROR — an ordinary source tree may hold
                # both, and failing the mandatory full verify over one would let
                # the optimization break the primary command. They are simply
                # unprovable: return 1 and the gate runs. `wc` consumes all of
                # its input, so no pipe here can take the SIGPIPE path.
                if [ "$(find "$tok" -type l -print 2>/dev/null | wc -l | tr -d ' ')" != "0" ]; then
                    return 1
                fi
                nul=$(find "$tok" -print0 2>/dev/null | tr -dc '\0' | wc -c | tr -d ' ')
                nl=$(find "$tok" -print 2>/dev/null | wc -l | tr -d ' ')
                [ "$nul" = "$nl" ] || return 1
                # Directories appear in the path list so that creating an empty
                # one is visible; a content hash alone cannot see it.
                find "$tok" \( -type f -o -type d \) -print 2>/dev/null | LC_ALL=C sort
                # A content hash is also blind to chmod, and losing an exec bit
                # is exactly what check #5 fails on. -perm -100 is the octal form
                # both BSD and GNU find accept.
                find "$tok" -type f -perm -100 -print 2>/dev/null | LC_ALL=C sort | sed 's/^/exec /'
                nfiles=$(find "$tok" -type f -print 2>/dev/null | wc -l | tr -d ' ')
                if [ "$nfiles" != "0" ]; then
                    # shellcheck disable=SC2086
                    hashed=$(find "$tok" -type f -print0 2>/dev/null | xargs -0 $HASH_CMD 2>/dev/null | LC_ALL=C sort)
                    # An unreadable file makes the hasher skip it while `find`
                    # still counted it. Silently, that yields a STABLE key that
                    # no longer describes those bytes — a false hit. Prove every
                    # counted file was actually hashed.
                    got=$(printf '%s\n' "$hashed" | grep -c .)
                    [ "$got" = "$nfiles" ] || return 1
                    printf '%s\n' "$hashed"
                fi
                ;;
        esac
    done
}

# _gate_key <label> <cmd> <tokens> — prints the digest, or nothing when the key
# cannot be computed. Exit 2 is a config error the caller turns into a FAIL.
_gate_key() {
    local material status
    material=$(_gate_material "$1" "$2" "$3"); status=$?
    [ "$status" -eq 0 ] || return "$status"
    # shellcheck disable=SC2086
    printf '%s\n' "$material" | $HASH_CMD 2>/dev/null | awk '{print $1; exit}'
}

# _live_key <label> — the key as of NOW. Deliberately recomputed at the moment
# of the hit test rather than reused from the prescan: the prescan runs before
# the first gate, and on a minutes-long run an edit landing in between would
# otherwise be served a hit keyed on bytes the gate never saw.
_live_key() {
    local toks
    toks=$(_toks_for "$1") || return 1
    _gate_key "$1" "$(_cmd_for "$1")" "$toks"
}

# Content-addressed: the FILENAME is the key. The hit test is one atomic [ -f ],
# concurrent parallel gates writing the same key write identical bytes (no race
# and no need for atomic rename), and reverting a change re-hits its old entry.
_cache_hit() { [ -n "$1" ] && [ -f "$CACHE_DIR/$1" ]; }
_cache_write() {
    [ -n "$1" ] || return 0
    mkdir -p "$CACHE_DIR" 2>/dev/null || return 0
    printf '%s\n' "$2" > "$CACHE_DIR/$1" 2>/dev/null || return 0
}

# Written on a pass in EVERY mode, so an ordinary full run warms the cache; only
# --changed ever READS it. Recomputing after the command and writing only on an
# unchanged digest NARROWS the write-side window in which the agent verify is
# gating edits the very files the gate declared, and gives "a gate that mutates
# its own declared inputs is never cached" for free. It cannot close that window
# completely: an input that changes and is reverted mid-run (ABA) hashes the
# same before and after. That residue is accepted — --changed is a local
# iteration mode, and CI and releases run the full gate set.
_cache_record() {
    local label="$1" key="$2" after
    [ -n "$key" ] || return 0
    after=$(_live_key "$label" 2>/dev/null) || return 0
    [ "$after" = "$key" ] || return 0
    _cache_write "$key" "$label"
}

_toks_for() {
    local i
    for ((i = 0; i < ${#INPUT_LABELS[@]}; i++)); do
        [ "${INPUT_LABELS[$i]}" = "$1" ] && { printf '%s' "${INPUT_TOKENS[$i]}"; return 0; }
    done
    return 1
}
_cmd_for() {
    local i
    for ((i = 0; i < ${#DECL_LABELS[@]}; i++)); do
        [ "${DECL_LABELS[$i]}" = "$1" ] && { printf '%s' "${DECL_CMDS[$i]}"; return 0; }
    done
    return 1
}

# Collect declarations and annotations in one pass, WITHOUT executing anything:
# a stale annotation must fail before the first gate runs, not after half the
# suite has. Plain file redirect, never a here-doc.
_prescan_gates() {
    local line rest kw lbl val
    while IFS= read -r line; do
        rest=${line#"${line%%[![:space:]]*}"}
        case "$rest" in
            '') continue ;;
            \#*)
                rest=${rest#\#}
                rest=${rest#"${rest%%[![:space:]]*}"}
                kw=${rest%%[[:space:]]*}
                [ "$kw" = inputs ] || continue
                rest=${rest#"$kw"}
                rest=${rest#"${rest%%[![:space:]]*}"}
                lbl=${rest%%[[:space:]]*}
                val=${rest#"$lbl"}
                val=${val#"${val%%[![:space:]]*}"}
                val=${val%"${val##*[![:space:]]}"}
                if [ -z "$lbl" ] || [ -z "$val" ]; then
                    echo "FAIL: malformed '# inputs' directive in .harness/gates.conf (want '# inputs <gate-label> <token>...'): '$line'" >&2
                    exit 1
                fi
                INPUT_LABELS[${#INPUT_LABELS[@]}]="$lbl"
                INPUT_TOKENS[${#INPUT_TOKENS[@]}]="$val"
                ;;
            *)
                kw=${rest%%[[:space:]]*}
                case "$kw" in gate|full|parallel) ;; *) continue ;; esac
                rest=${rest#"$kw"}
                rest=${rest#"${rest%%[![:space:]]*}"}
                lbl=${rest%%[[:space:]]*}
                val=${rest#"$lbl"}
                val=${val#"${val%%[![:space:]]*}"}
                val=${val%"${val##*[![:space:]]}"}
                DECL_LABELS[${#DECL_LABELS[@]}]="$lbl"
                DECL_CMDS[${#DECL_CMDS[@]}]="$val"
                ;;
        esac
    done < "$GATES_CONF"
}

_validate_inputs() {
    local i j lbl status
    # Two gates sharing a label share one cache key, because a key is derived
    # from the label's annotation and its FIRST matching declaration. The
    # passing twin would then warm a key the failing twin is served on the next
    # run — a green verify covering a gate that fails. Duplicate labels are
    # already meaningless (both report under one name), so refuse them outright.
    for ((i = 0; i < ${#DECL_LABELS[@]}; i++)); do
        for ((j = 0; j < i; j++)); do
            if [ "${DECL_LABELS[$j]}" = "${DECL_LABELS[$i]}" ]; then
                echo "FAIL: gate label '${DECL_LABELS[$i]}' is declared more than once in .harness/gates.conf — labels identify gates in reports and in the --changed cache; make them unique" >&2
                exit 1
            fi
        done
    done
    for ((i = 0; i < ${#INPUT_LABELS[@]}; i++)); do
        lbl="${INPUT_LABELS[$i]}"
        for ((j = 0; j < i; j++)); do
            if [ "${INPUT_LABELS[$j]}" = "$lbl" ]; then
                echo "FAIL: '# inputs' is declared more than once for gate '$lbl' in .harness/gates.conf — which set applies is ambiguous" >&2
                exit 1
            fi
        done
        if ! _cmd_for "$lbl" >/dev/null; then
            echo "FAIL: '# inputs' names gate '$lbl', which no gate/full/parallel line declares — a stale annotation silently never applies; fix or remove it in .harness/gates.conf" >&2
            exit 1
        fi
        # --fast runs no annotated gate, so skip the hashing but keep the cheap
        # structural checks above. The key itself is NOT kept: it is recomputed
        # at each gate's hit test (see _live_key). This pass exists to surface a
        # config error before the first gate runs, not to memoize.
        [ "$MODE" = fast ] && continue
        _gate_key "$lbl" "$(_cmd_for "$lbl")" "${INPUT_TOKENS[$i]}" >/dev/null; status=$?
        if [ "$status" -eq 2 ]; then
            echo "FAIL: '# inputs' for gate '$lbl' cannot be used (see the message above); fix it in .harness/gates.conf" >&2
            exit 1
        fi
    done
}

# gate <label> <command...>          — runs in both modes; keep these fast (ms-s).
# full_gate <label> <command...>     — serial; skipped under --fast.
# parallel_full_gate <label> <cmd...> — independent; queued until the barrier.
# Commands run verbatim ("$@"); wrap pipelines in `bash -c '...'`.
format_command() {
    local arg escaped rendered=""
    for arg in "$@"; do
        printf -v escaped '%q' "$arg"
        rendered="${rendered}${rendered:+ }${escaped}"
    done
    printf '%s' "$rendered"
}

run_gate() {
    local label="$1" out command status started duration outcome key; shift
    key=$(_live_key "$label") || key=""
    if [ "$MODE" = changed ] && _cache_hit "$key"; then
        CACHED_SKIPS=$((CACHED_SKIPS + 1))
        echo "ok:   $label (cached — inputs unchanged)"
        return 0
    fi
    command=$(format_command "$@")
    started=$SECONDS
    if out=$("$@" 2>&1); then
        status=0
        outcome=pass
        duration=$((SECONDS - started))
        emit_gate_event "$label" "$outcome" "$status" "$duration"
        _cache_record "$label" "$key"
        echo "ok:   $label"
    else
        status=$?
        outcome=fail
        duration=$((SECONDS - started))
        emit_gate_event "$label" "$outcome" "$status" "$duration"
        printf '%s\n' "$out"
        echo "FAIL: $label — fix, then re-run: $command"
        exit 1
    fi
}
gate() { run_gate "$@"; }
full_gate() {
    [ "$MODE" = "fast" ] && return 0
    # A serial full gate is also a dependency barrier for any parallel phase
    # declared before it. Do not let a consumer race its queued producers.
    wait_parallel_gates || exit 1
    run_gate "$@"
}

# Bash 3.2-compatible parallel gate queue (macOS still ships Bash 3.2). Output
# is buffered per gate so concurrent commands cannot interleave unreadably.
# Declaration order controls reporting order, not execution order — with one
# exception: a gate skipped by the --changed cache never enters this queue, so
# it reports at its declaration point rather than at the barrier. Concurrency
# is bounded to $JOBS without `wait -n` (not in Bash 3.2): when the queue is
# full, spawning blocks on the OLDEST still-running job and records its status
# for the barrier.
PARALLEL_PIDS=()
PARALLEL_LABELS=()
PARALLEL_OUTPUTS=()
PARALLEL_METAS=()
PARALLEL_COMMANDS=()
PARALLEL_ACTIVE=()
PARALLEL_STATUS=()
PARALLEL_DIR=""

cleanup_parallel_gates() {
    local index pid
    for ((index = 0; index < ${#PARALLEL_PIDS[@]}; index++)); do
        [ "${PARALLEL_ACTIVE[$index]:-0}" -eq 1 ] || continue
        pid=${PARALLEL_PIDS[$index]}
        kill "$pid" 2>/dev/null || true
    done
    [ -n "$PARALLEL_DIR" ] && rm -rf "$PARALLEL_DIR"
}
trap cleanup_parallel_gates EXIT

# reap_parallel_gate <index> — wait for one active job and record its raw
# wait status; the barrier prefers the meta file (written by the child) and
# falls back to this recorded value when the child died before writing it.
reap_parallel_gate() {
    local index="$1" status
    if wait "${PARALLEL_PIDS[$index]}"; then status=0; else status=$?; fi
    # wait reaped this child; never retain a stale PID that could be reused
    # and signaled by the EXIT cleanup while a later gate is still running.
    PARALLEL_ACTIVE[$index]=0
    PARALLEL_STATUS[$index]=$status
}

# throttle_parallel_gates — block until fewer than $JOBS jobs are running, by
# reaping the oldest active one. Oldest-first keeps the logic Bash 3.2-safe
# (no `wait -n`) and costs little: gates are declared roughly cheapest-first,
# so the oldest running job is usually the next to finish anyway.
throttle_parallel_gates() {
    local index running oldest
    while :; do
        running=0; oldest=-1
        for ((index = 0; index < ${#PARALLEL_PIDS[@]}; index++)); do
            [ "${PARALLEL_ACTIVE[$index]:-0}" -eq 1 ] || continue
            running=$((running + 1))
            [ "$oldest" -lt 0 ] && oldest=$index
        done
        [ "$running" -lt "$JOBS" ] && return 0
        reap_parallel_gate "$oldest"
    done
}

parallel_full_gate() {
    [ "$MODE" = "fast" ] && return 0
    local label="$1" index out meta key; shift
    # Hit test in the PARENT, before forking: a cached gate costs no process.
    key=$(_live_key "$label") || key=""
    if [ "$MODE" = changed ] && _cache_hit "$key"; then
        CACHED_SKIPS=$((CACHED_SKIPS + 1))
        echo "ok:   $label (cached — inputs unchanged)"
        return 0
    fi
    if [ -z "$PARALLEL_DIR" ]; then
        PARALLEL_DIR=$(mktemp -d "${TMPDIR:-/tmp}/harness-verify.XXXXXX") || {
            echo "FAIL: could not create parallel-gate scratch directory" >&2
            exit 1
        }
    fi
    throttle_parallel_gates
    index=${#PARALLEL_PIDS[@]}
    out="$PARALLEL_DIR/$index.out"
    meta="$PARALLEL_DIR/$index.meta"
    (
        started=$SECONDS
        "$@" >"$out" 2>&1
        status=$?
        duration=$((SECONDS - started))
        # Recorded by the CHILD, which is the process that knows the command
        # actually ran to completion here.
        [ "$status" -eq 0 ] && _cache_record "$label" "$key"
        printf '%s %s\n' "$status" "$duration" >"$meta" 2>/dev/null || true
        exit "$status"
    ) &
    PARALLEL_PIDS[$index]=$!
    PARALLEL_ACTIVE[$index]=1
    PARALLEL_LABELS[$index]="$label"
    PARALLEL_OUTPUTS[$index]="$out"
    PARALLEL_METAS[$index]="$meta"
    PARALLEL_COMMANDS[$index]=$(format_command "$@")
}

wait_parallel_gates() {
    local index status recorded_status duration outcome failed=0
    for ((index = 0; index < ${#PARALLEL_PIDS[@]}; index++)); do
        # The throttle may have reaped this job already (its status is
        # recorded); wait on the still-active rest here, in declaration order.
        if [ "${PARALLEL_ACTIVE[$index]:-0}" -eq 1 ]; then
            reap_parallel_gate "$index"
        fi
        status=${PARALLEL_STATUS[$index]:-0}
        recorded_status=$status
        duration=0
        if [ -s "${PARALLEL_METAS[$index]}" ]; then
            read -r recorded_status duration < "${PARALLEL_METAS[$index]}" || true
        fi
        case "$recorded_status" in ''|*[!0-9]*) recorded_status=$status ;; esac
        case "$duration" in ''|*[!0-9]*) duration=0 ;; esac
        if [ "$recorded_status" -eq 0 ]; then outcome=pass; else outcome=fail; fi
        emit_gate_event "${PARALLEL_LABELS[$index]}" "$outcome" "$recorded_status" "$duration"
        if [ "$recorded_status" -eq 0 ]; then
            echo "ok:   ${PARALLEL_LABELS[$index]}"
        else
            [ -s "${PARALLEL_OUTPUTS[$index]}" ] \
                && cat "${PARALLEL_OUTPUTS[$index]}"
            echo "FAIL: ${PARALLEL_LABELS[$index]} — fix, then re-run: ${PARALLEL_COMMANDS[$index]}"
            failed=1
        fi
    done
    PARALLEL_PIDS=()
    PARALLEL_LABELS=()
    PARALLEL_OUTPUTS=()
    PARALLEL_METAS=()
    PARALLEL_COMMANDS=()
    PARALLEL_ACTIVE=()
    PARALLEL_STATUS=()
    [ -n "$PARALLEL_DIR" ] && rm -rf "$PARALLEL_DIR"
    PARALLEL_DIR=""
    return "$failed"
}

# Test seam: an optional prelude sourced before the gate declarations are
# read. The shipped tests/test-verify.sh uses it to drive the parallel
# machinery directly (the cleanup PID-selection case) without editing this
# runner. Unset outside the test suite.
# shellcheck source=/dev/null
[ -n "${HARNESS_VERIFY_PRELUDE:-}" ] && . "$HARNESS_VERIFY_PRELUDE"

_prescan_gates
_validate_inputs

# Read the repo's gate declarations. `read kind label cmdstr` leaves the
# command (with its internal spacing) in cmdstr.
while IFS= read -r _line; do
    case "$_line" in ''|\#*) continue ;; esac
    # Split with parameter expansion, NOT `read <<LINE`. A here-doc needs a
    # temp file (bash 3.2: $TMPDIR, then a CWD fallback), and a failed
    # redirection under `set -uo pipefail` without `set -e` skips the read and
    # leaves all three fields empty — which the check below would then report as
    # a MALFORMED gates.conf line, blaming the repo's config for the
    # environment. The `cd "$ROOT"` above means the CWD fallback normally saves
    # it, so this is narrower than the fail-open class in the check families
    # (and fails closed, not open); a read-only checkout plus an unwritable
    # $TMPDIR is still enough to produce the misleading diagnostic. Expansion
    # needs no temp file at all. Same field semantics as
    # `read -r kind label cmdstr`: leading whitespace skipped, first two
    # whitespace-delimited words split off, the remainder — internal spacing
    # intact, trailing whitespace stripped — left in cmdstr.
    _rest=${_line#"${_line%%[![:space:]]*}"}
    kind=${_rest%%[[:space:]]*}
    _rest=${_rest#"$kind"}
    _rest=${_rest#"${_rest%%[![:space:]]*}"}
    label=${_rest%%[[:space:]]*}
    _rest=${_rest#"$label"}
    cmdstr=${_rest#"${_rest%%[![:space:]]*}"}
    cmdstr=${cmdstr%"${cmdstr##*[![:space:]]}"}
    if [ -z "$kind" ] || [ -z "$label" ] || [ -z "$cmdstr" ]; then
        echo "FAIL: malformed .harness/gates.conf line (want '<kind> <label> <command...>'): '$_line'" >&2
        exit 1
    fi
    case "$kind" in
        gate)     gate "$label" bash -c "$cmdstr" ;;
        full)     full_gate "$label" bash -c "$cmdstr" ;;
        parallel) parallel_full_gate "$label" bash -c "$cmdstr" ;;
        parallel-each)
            # cmdstr is one or more globs, expanded from the repo root. A
            # glob matching NOTHING is a config error, never a silent skip:
            # zero gates from a typo'd glob would fake a green verify.
            _matched=0
            for _f in $cmdstr; do
                [ -f "$_f" ] || continue
                _matched=1
                parallel_full_gate "$label: $(basename "$_f")" bash "$_f"
            done
            if [ "$_matched" -eq 0 ]; then
                echo "FAIL: parallel-each '$label' matched no files (globs: $cmdstr) — an empty gate would pass vacuously; fix the glob in .harness/gates.conf or remove the declaration" >&2
                exit 1
            fi
            ;;
        *)
            echo "FAIL: unknown gate kind '$kind' in .harness/gates.conf" >&2
            exit 1
            ;;
    esac
done < "$GATES_CONF"

wait_parallel_gates || exit 1
if [ "$MODE" = changed ]; then
    echo "OK: all quality gates passed ($MODE; $CACHED_SKIPS cached)"
else
    echo "OK: all quality gates passed ($MODE)"
fi
exit 0
