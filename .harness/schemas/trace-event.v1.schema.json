{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harness-kit/trace-event.v1.schema.json",
  "title": "Provider-neutral agent trace event (version 1)",
  "type": "object",
  "required": ["version", "seq", "ts", "provider", "type", "attributes"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "seq": { "type": "integer", "minimum": 1 },
    "ts": { "type": ["string", "null"] },
    "provider": { "enum": ["claude", "codex"] },
    "type": {
      "enum": ["session.started", "session.finished", "file.read", "file.search", "file.write", "command.started", "command.finished", "tool.started", "tool.finished"]
    },
    "attributes": { "type": "object" }
  }
}
